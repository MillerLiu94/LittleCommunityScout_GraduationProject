# 複製成 .env 並填入真實值：cp .env.example .env
# 其他（.env、憑證、gcs 金鑰）已被 .gitignore 排除，不會進版本庫。

# Tavily 聯網搜尋（Researcher 工具）
TAVILY_API_KEY=

# Google Maps Places API (New) 與 Geocoding API（後端用）
GOOGLE_MAPS_API_KEY=

# 新前端（LCS_project）地圖用；由 /api/runtime-config.js 提供給瀏覽器。
# 請在 Google Cloud 限制允許網域，勿與後端金鑰共用。
GOOGLE_MAPS_BROWSER_API_KEY=

# 新前端執行期設定（由 /api/runtime-config.js 提供）
MOCK_AUTHOR_ACCOUNT=test1
# 設為 1/true 可在桌機預覽申報流程（預設只允許手機）
FRONTEND_ALLOW_DESKTOP_REPORT_PREVIEW=

# PostgreSQL 連線（含 pgvector）。例：postgresql://user:pass@localhost:5432/community
DATABASE_URL=

# AI chat／vision agent 專用的唯讀連線（readonly_user）。
# 未設定時聊天工具會停用，不會回退到 DATABASE_URL。
# 例：postgresql://readonly_user:pass@localhost:5432/community
READONLY_DATABASE_URL=

# Ollama 本機模型
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 語音轉文字（POST multipart：file、language）
TRANSCRIPTION_API_URL=http://100.109.236.89:8002/transcribe

# 圖片儲存：gcs 或 local（gcs 失敗會自動退回 local）
STORAGE_BACKEND=local
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# 開發時 hot reload
UVICORN_RELOAD=1

# LINE Login（LINE Login channel，不是 Messaging API channel）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 必須與 LINE Developers Console 的 Callback URL 完全一致
LINE_LOGIN_REDIRECT_URI=https://your-domain/api/auth/line/callback
# 前端會組成 /api + LINE_LOGIN_PATH
LINE_LOGIN_PATH=/auth/line/login
LINE_LOGIN_SCOPE=profile
# 選填：normal / aggressive；留空表示不顯示加入好友提示
LINE_LOGIN_BOT_PROMPT=
# OAuth state 有效秒數
LINE_LOGIN_STATE_TTL=600

# 登入後導回的前端（可填完整 URL；路徑會接在 FRONTEND_BASE_URL 後）
FRONTEND_BASE_URL=https://your-domain
LINE_LOGIN_SUCCESS_PATH=/pages/login/login.html?login=success
LINE_LOGIN_FAILURE_PATH=/pages/login/login.html?login=failed

# 簽署 session cookie 與 OAuth state；必填，否則 LINE 登入會停用
# 產生：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=lcs_session
SESSION_MAX_AGE=604800
# 本機 HTTP 開發設 false；正式 HTTPS 設 true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# 前後端不同 origin 且直接連線時才需要（逗號分隔）
CORS_ALLOW_ORIGINS=